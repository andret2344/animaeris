###> symfony/framework-bundle ###
APP_ENV=dev
# Real secret lives in .env.local (gitignored). Never commit a production APP_SECRET.
# Use this command to generate it:
# php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
# Real Gmail credentials live in .env.local (gitignored). Never commit them.
# Use a Gmail App Password (https://myaccount.google.com/apppasswords), not the account password:
# MAILER_DSN=gmail://animaeris.studio%40gmail.com:APP_PASSWORD@default
MAILER_DSN=null://null
###< symfony/mailer ###
